<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 与 Linux 侧 linuxctl / DSH Web 通信（127.0.0.1） -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- 前台服务：常驻状态通知 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- Android 14+ 必须为 specialUse 类型单独声明 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- 开机自启（可选，设置页开关） -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- 电池优化白名单申请：环境需要长期存活 -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- 刻意不申请任何存储权限：本 App 只通过 linuxctl 与环境交互，
         sdcard 直挂由 root 侧的挂载树负责。 -->

    <application
        android:name=".SunsetLinuxApp"
        android:allowBackup="false"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.SunsetLinux">

        <activity
            android:windowSoftInputMode="adjustResize"
            android:name=".LauncherActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.SunsetLinux.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 加载 DSH Web GUI。configChanges 让旋转不重建 Activity，
             WebView 因此不会重放一次带令牌的登录跳转（虽然令牌可复用，但没必要）。 -->
        <activity
            android:windowSoftInputMode="adjustResize"
            android:name=".DshWebActivity"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden|uiMode"
            android:exported="false"
            android:launchMode="singleTop" />

        <!-- 首启引导：模式选择 / 模块安装指引 / 部署 / 完成 -->
        <activity
            android:windowSoftInputMode="adjustResize"
            android:name=".WelcomeActivity"
            android:exported="false"
            android:launchMode="singleTop" />

        <activity
            android:windowSoftInputMode="adjustResize"
            android:name=".ProvisionActivity"
            android:exported="false" />

        <!-- 一键诊断（doctor 流式输出 + 复制 + 导出） -->
        <activity
            android:windowSoftInputMode="adjustResize"
            android:name=".DiagnosticsActivity"
            android:exported="false" />

        <activity
            android:windowSoftInputMode="adjustResize"
            android:name=".SettingsActivity"
            android:exported="false" />

        <activity
            android:windowSoftInputMode="adjustResize"
            android:name=".LogActivity"
            android:exported="false" />

        <activity
            android:windowSoftInputMode="adjustResize"
            android:name=".UpdateActivity"
            android:exported="false" />

        <service
            android:name=".service.LinuxService"
            android:exported="false"
            android:foregroundServiceType="specialUse"
            android:stopWithTask="false">
            <!-- Android 14+ 要求 specialUse 必须给出子类型说明 -->
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="dsh_linux_environment_supervision" />
        </service>

        <!-- 排障包分享：FileProvider 只暴露 cacheDir/exports 与 filesDir/crash。
             ★ authority 必须跟着 applicationId 走，**不能写死**（真机实测 2026-09-19）：
               · authority 在系统里是**全局唯一**的，而两个 edition 的包名不同
                 （…sunsetlinux.root / …sunsetlinux.proot）—— 写死成同一个字符串，
                 第二个 App 直接装不上：安装器报「存在同名的 ContentProvider」；
               · 而且代码里请求的是 `"${context.packageName}.files"`
                 （core/LogExport.kt、core/BundledModule.kt），写死的那份谁也匹配不上
                 ⇒ 导出日志 / 分享排障包在真机上**本来就是坏的**（会抛
                 "Couldn't find meta-data for provider with authority …"）。
             `${applicationId}` 一处同时修掉这两个问题：edition 之间唯一，且与代码一致。 -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <receiver
            android:name=".service.BootReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
    </application>

</manifest>

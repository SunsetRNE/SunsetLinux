# ============================================================================
# SunsetLinux —— 开源前的 .gitignore
#
# 原则：**只提交源码与文档**；构建产物、下载缓存、密钥一律不进仓库。
# 发布产物（APK / 模块 zip / 三层镜像 / 频道）走 Releases 或频道托管，不提交。
# ============================================================================

# ---- 构建产物 --------------------------------------------------------------
build/
dist/
.tools/
app/build/
app/.gradle/
app/.kotlin/
app/local.properties
*.apk
*.aab
*.idsig

# ---- 密钥与凭据（★ 最重要：私钥绝不可进仓库）-------------------------------
# tools/channel/keygen.mjs 会在当前目录生成 channel.key（私钥，0600）。
# 它一旦提交，任何人都能签出"你的"频道 —— 等于签名体系失效。
*.key
channel.key
*.jks
*.keystore
*.p12
*.pem
.env
.env.*
credentials*
.sunsetlinux-keys/

# ---- 下载缓存 / 临时目录 ---------------------------------------------------
*.tar.zst
*.tar.gz
*.tar.xz
*.erofs
*.erofs.zst
*.erofs.gz
*.squashfs
*.img
*.part
dist/.seed-cache/

# ---- 编辑器 / 系统 ---------------------------------------------------------
.idea/
.vscode/
*.iml
.DS_Store
Thumbs.db
*.swp
*~

# ---- 语言运行时 ------------------------------------------------------------
__pycache__/
*.pyc
node_modules/

# ---- 测试与调试残留 --------------------------------------------------------
*.log
/tmp/
.cmp-consistency-out
